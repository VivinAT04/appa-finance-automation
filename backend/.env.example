PORT=4000

# Generate a unique secret for each deployment.
# Example:
# openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters

# Development bootstrap account.
# Never commit real credentials.
APPA_ADMIN_EMAIL=admin@example.com
APPA_ADMIN_PASSWORD=replace-with-a-strong-development-password
APPA_ADMIN_NAME=APPA Administrator
