# PostgreSQL / Supabase
DATABASE_URL=postgresql://user:password@host:5432/postgres
DATABASE_POOL_MAX=10

PORT=4000

# Generate a unique secret for each deployment.
# Example:
# openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters

# Development bootstrap account.
# Never commit real credentials.
APPA_ADMIN_EMAIL=admin@example.com
APPA_ADMIN_PASSWORD=replace-with-a-strong-development-password
APPA_ADMIN_NAME=APPA Administrator

# UiPath / RPA robot integration.
# Generate a unique API key for each deployment:
# openssl rand -hex 32
RPA_API_KEY=replace-with-at-least-32-random-characters
RPA_ROBOT_NAME=APPA UiPath Robot
