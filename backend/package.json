{
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js",
    "db:postgres:schema": "node scripts/createPostgresSchema.js",
    "db:postgres:migrate": "node scripts/migrateSqliteToPostgres.js",
    "test:rpa": "node test/rpaContract.js",
    "test:legacy:isolation": "node -r dotenv/config test/crossOrganisationIsolation.js",
    "test:legacy:users": "node -r dotenv/config test/userAdministrationIsolation.js",
    "test:readiness": "node test/releaseReadiness.js",
    "test:release": "npm run test:rpa && npm run test:readiness",
    "test": "npm run test:release"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=22"
  }
}
